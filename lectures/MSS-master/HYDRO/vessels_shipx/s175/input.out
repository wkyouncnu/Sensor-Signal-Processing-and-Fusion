     MASTER CONTROL CARD DATA
     ************************

     ICAL   =  1
            => The motion transfer functions to be computed

     IVISC  =  1
            => Viscous damping included

     IMETH =  1
            => Ordinary strip theory

     IMTNCOORD =  2
            => Motion coord. system vertically at COG

     IGNORE_MASSBALANCE_CHECK =  0
            => Mass balance is allways enforced

     IGFORC =  0
            => No global loads are to be calculated

     IMONOHULL  =  1
            => Monohull

     IGMCAL =  1
            => Metacentric heights to be calculated

     IADDR =  1
            => Added resistance to be calculated
               using Gerritsma & Beukelman's method

     IOUTRE7  =  1
            => Generate hydrodynamic coefficient output file

     ISTRIP   =  0
            => No STRIP.STR geometry output file

     IOUTPRESS=  0
            => No pressure output file

     IOUTWAMIT=  0
            => No WAMIT output files

     IADDDA =  0
            => No additional damping as input

     IADDMA =  0
            => No additional added mass as input

     IADDST =  0
            => No additional stiffness as input


